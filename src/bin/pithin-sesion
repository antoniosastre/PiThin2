#!/usr/bin/env bash
# pithin-sesion - bucle de sesión RDP.
#
# Se ejecuta de dos maneras según el backend:
#
#   x11   dentro del servidor X, lanzado por xinitrc.
#   sdl   directamente desde la consola de texto, sin servidor gráfico
#         de ningún tipo.
#
# La contraseña no se pide aquí: whiptail necesita un terminal de texto
# y en la sesión gráfica no lo hay. Se pide antes de arrancar y llega por
# un fichero en tmpfs que esta orden lee y destruye al instante.

set -uo pipefail

export PITHIN_LIB="${PITHIN_LIB:-/usr/local/lib/pithin}"
# shellcheck source=/dev/null
source "$PITHIN_LIB/pithin-config.sh"
# shellcheck source=/dev/null
source "$PITHIN_LIB/pithin-vpn.sh"
# shellcheck source=/dev/null
source "$PITHIN_LIB/pithin-rdp.sh"
# shellcheck source=/dev/null
source "$PITHIN_LIB/pithin-tui.sh"

MOTIVO="/run/pithin/ultimo-motivo"
ESTADO="/run/pithin/estado-sesion"

anotar() {
    install -d -m 0700 /run/pithin 2>/dev/null || true
    printf '%s' "$1" >"$MOTIVO" 2>/dev/null || true
    printf '%s' "$2" >"$ESTADO" 2>/dev/null || true
}

# Ajustes que solo tienen sentido dentro de un servidor X. Con el
# backend SDL no hay ninguno, y la distribución de teclado la resuelven
# el keymap de la consola y el /kbd:layout que se le pasa a FreeRDP.
preparar_x11() {
    [[ -n "${DISPLAY:-}" ]] || return 0
    setxkbmap "$TECLADO" 2>/dev/null || true
    # Nada de salvapantallas: esto es un terminal, no un escritorio.
    xset s off -dpms s noblank 2>/dev/null || true
}

main() {
    config_cargar || true
    preparar_x11

    # Lo pone lanzar_sesion cuando se estrena un backend: la sesión se
    # cierra sola para que se pueda comprobar si el teclado responde sin
    # riesgo de quedarse encerrado en ella.
    RDP_LIMITE_SEGUNDOS="${PITHIN_LIMITE_SESION:-0}"
    [[ "$RDP_LIMITE_SEGUNDOS" =~ ^[0-9]+$ ]] || RDP_LIMITE_SEGUNDOS=0

    local secreto
    if ! secreto="$(tui_recoger_secreto)"; then
        log_error "No se recibió la contraseña; se cierra la sesión."
        anotar "No se pudo obtener la contraseña de Windows." "fallo"
        return 1
    fi

    local intentos=0 codigo
    while true; do
        codigo=0
        rdp_conectar "$secreto" || codigo=$?

        if (( RDP_TERMINO_POR_LIMITE )); then
            anotar "$RDP_ULTIMO_MOTIVO" "limite"
            break
        fi

        if (( codigo == 0 )); then
            anotar "$RDP_ULTIMO_MOTIVO" "ok"
            break
        fi

        anotar "$RDP_ULTIMO_MOTIVO" "fallo"

        es_si "$RECONEXION_AUTOMATICA" || break

        # Un fallo de credenciales o de sintaxis no se arregla
        # reintentando: solo haría perder tiempo delante de una
        # pantalla en negro.
        if ! rdp_fallo_recuperable; then
            log_info "El fallo necesita intervención; no se reintenta."
            break
        fi

        intentos=$((intentos + 1))
        if (( RECONEXION_MAX_INTENTOS > 0 && intentos >= RECONEXION_MAX_INTENTOS )); then
            log_aviso "Agotados los $RECONEXION_MAX_INTENTOS reintentos."
            anotar "$RDP_ULTIMO_MOTIVO

Se reintentó $intentos veces sin conseguirlo." "fallo"
            break
        fi

        log_info "Reintento $intentos en ${RECONEXION_ESPERA}s..."
        sleep "$RECONEXION_ESPERA"
    done

    unset secreto
    return 0
}

main "$@"
